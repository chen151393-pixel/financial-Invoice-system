{
  "name": "ns-invoice-center-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node scripts/python.mjs -m backend",
    "test": "npm run build && npm run test:http && npm run test:reconciliation && npm run test:api",
    "test:http": "node --experimental-strip-types --test tests/http.test.mjs",
    "test:reconciliation": "node --test tests/pl-comparison.test.mjs tests/ns-finance-source.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:prototype": "node scripts/vinext.mjs dev",
    "build:prototype": "node scripts/vinext.mjs build",
    "test:prototype": "npm run build:prototype && node --test tests/rendered-html.test.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "test:api": "node scripts/python.mjs -m pytest backend/tests",
    "db:upgrade": "node scripts/python.mjs -m backend.manage upgrade",
    "db:sql:mysql": "node scripts/python.mjs -m backend.manage mysql-sql",
    "db:business:check": "node scripts/python.mjs -m backend.manage business-check",
    "db:business:upgrade": "node scripts/python.mjs -m backend.manage business-upgrade",
    "db:business:sql": "node scripts/python.mjs -m backend.manage business-sql",
    "lint:api": "node scripts/python.mjs -m ruff check backend",
    "typecheck": "tsc -p web/tsconfig.json",
    "check:architecture": "node scripts/check-web-architecture.mjs && node scripts/python.mjs -m pytest backend/tests/test_architecture.py",
    "format:web": "prettier --write web app/demo app/page.tsx app/globals.css scripts/*.mjs",
    "format:api": "node scripts/python.mjs -m ruff format backend",
    "format:check": "prettier --check web app/demo app/page.tsx app/globals.css scripts/*.mjs && node scripts/python.mjs -m ruff format --check backend",
    "check": "npm run lint && npm run lint:api && npm run typecheck && npm run check:architecture && npm run format:check && npm test"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
