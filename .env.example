# 项目配置模板（可以提交代码库，但不能填写真实凭据）。
# 首次配置时复制为 .env；已有配置只补缺项，不能覆盖凭证。
# 本地后端：进程环境变量 > .env.local > .env；Docker 依次加载 .env、.env.local。
# 不要放在 web/ 或 public/，不要使用 VITE_ 前缀保存秘密。

# NetSuite M2M 认证；账户标识决定沙箱或生产环境的请求地址。
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_SCOPE=rest_webservices,restlets
# 填写后端可访问的私钥路径；Docker 使用容器内路径，例如 /run/secrets/ns-private.pem。
NETSUITE_PRIVATE_KEY_PATH=
# PS256 使用 RSA 私钥；EC 私钥选择匹配的 ES256/ES384/ES512。
NETSUITE_JWT_ALGORITHM=PS256
# 必须明确允许访问的 NS record type，多个值用英文逗号分隔。
NETSUITE_RECORD_TYPES=
# 按 record type 配置可写顶层字段，默认不允许任何字段。
# 示例仅用于理解格式：{"vendorBill":["memo","externalId"]}
NETSUITE_WRITE_FIELDS={}
NETSUITE_WRITE_ENABLED=false

# 核对页调用只读 RESTlet，需在 NS 集成启用 RESTlets，并使用上述两个 scope。
# 部署说明见 docs/pl-script-integration.md；未配置时明确失败，不回退旧查询规则。
NETSUITE_PL_RESTLET_SCRIPT=
NETSUITE_PL_RESTLET_DEPLOY=
# 已核实的沙箱映射见 docs/netsuite-pl-lookup.json；核对当前账户后压为单行 JSON。
NETSUITE_PL_LOOKUP={}
# 同步列表查询日期格式须与 NS 账户一致：YYYY-MM-DD、M/D/YYYY 或 D/M/YYYY。
NETSUITE_SYNC_DATE_FORMAT=YYYY-MM-DD
# 原始报关行接口的脚本和部署编号须同时填写；未部署时标记来源未完整。
NETSUITE_FINANCE_SOURCE_SCRIPT=
NETSUITE_FINANCE_SOURCE_DEPLOY=

# 子采购合同专用 RESTlet；脚本和部署编号须同时填写。
NETSUITE_SUBPO_CONTRACT_SCRIPT=
NETSUITE_SUBPO_CONTRACT_DEPLOY=
# 可选：服务端专用 NS 认证 .env 文件路径；Docker 使用容器内已挂载的文件路径。
NETSUITE_SUBPO_CONNECTION_FILE=
# 合同共享盘根目录，修改后重启后端生效；不配置时禁止保存。
# Windows 可填 UNC 路径；Linux/Docker 填已挂载共享盘的容器内绝对路径，运行账号须有写入权限。
# 新合同只写入共享盘，系统仅保存路径与元数据，不缓存 PDF；归档失败后重试会重新从 NS 获取。
# 系统按北京时间下载日期建立子目录；此处不要追加日期文件夹。
NETSUITE_SUBPO_ARCHIVE_ROOT=

# 身份与访问入口。
ADMIN_USERNAME=admin
# 本机直接进入工作台；开启时 HOST 和 APP_ORIGIN 必须使用本机地址。
LOCAL_BROWSER_ACCESS=false
# 密码登录 API 需要非空值；本机自动建立会话不使用该密码。与 NS 凭证无关。
ADMIN_PASSWORD=
# 后续飞书等服务调用的独立密钥，至少 32 位；空值禁用服务调用。
SERVICE_API_KEY=
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# 前端开发端口；npm run dev 自动据此设置 APP_ORIGIN 和 API 代理。
WEB_PORT=5173
# 后端直接提供 HTTPS 时同时设置；反向代理终止 HTTPS 时留空。
TLS_CERT_PATH=
TLS_KEY_PATH=

# 统一业务库：审核、开票跟进、供应商群、采购报关、发票与匹配共用此连接。
# 正式启动须配置 USER；密码填写原文，无需 URL 编码。不再配置 SQLite 应用库。
# Docker 值包含 $ 时使用单引号包裹，避免 Compose 插值。
BUSINESS_MYSQL_HOST=127.0.0.1
BUSINESS_MYSQL_PORT=3306
BUSINESS_MYSQL_DATABASE=financial_invoice_business
BUSINESS_MYSQL_USER=
BUSINESS_MYSQL_PASSWORD=
# 也可只设置 BUSINESS_DATABASE_URL，此时删除上述 BUSINESS_MYSQL_* 各项，不能混用。
# BUSINESS_DATABASE_URL=mysql+pymysql://invoice_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/financial_invoice_business?charset=utf8mb4

# 企微客户群查询：配置客户联系凭证，或已授权客户联系的自建应用凭证。
WECOM_CORP_ID=
WECOM_SECRET=
# 可选：服务器本地 JSON 文件，含 corpid 和 secret；设置后优先使用该文件。
# 凭证文件不要放在 public、dist、web 等公开目录；页面不会返回凭证。
WECOM_CONNECTION_FILE=

# 柠檬云已有账号授权：目前只接收回调，尚未实现正式账号绑定或 API 同步。
# 公网回调地址由 APP_ORIGIN + /api/lemon/oauth/callback 自动生成；
# 例如 APP_ORIGIN=https://invoice.yesion.net，不要追加页面路径或末尾斜杠。
# 客服开通后填写正式环境的正整数 AppId；留空仍可访问回调入口做就绪检查。
LEMON_OPEN2_APP_KEY=
