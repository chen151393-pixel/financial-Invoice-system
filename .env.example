# NetSuite Sandbox 配置模板（可以提交代码库，但不能填写真实凭据）
NETSUITE_ENVIRONMENT=SANDBOX
NETSUITE_ACCOUNT_ID=
NETSUITE_REST_BASE_URL=
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_ENTITY_ID=
NETSUITE_ROLE_ID=
NETSUITE_SUBSIDIARY_ID=
NETSUITE_SCOPE=rest_webservices
NETSUITE_PRIVATE_KEY_PATH=

# 后端读取 .env.local；不要放在 web/ 或 public/，不要使用 VITE_ 前缀保存秘密。
# SuiteTalk REST 记录接口；现阶段不调用自定义 RESTlet。
# PS256 使用 RSA 私钥；EC 私钥选择匹配的 ES256/ES384/ES512。
NETSUITE_JWT_ALGORITHM=PS256
# 必须明确允许访问的 NS record type，多个值用英文逗号分隔。
NETSUITE_RECORD_TYPES=
# 已核实的沙箱映射见 docs/netsuite-pl-lookup.json；核对当前账户后压为单行 JSON 填入此处。
NETSUITE_PL_LOOKUP={}
# 按 record type 配置可写顶层字段，默认不允许任何字段。
# 示例仅用于理解格式：{"vendorBill":["memo","externalId"]}
NETSUITE_WRITE_FIELDS={}
NETSUITE_WRITE_ENABLED=false

ADMIN_USERNAME=admin
# 本机直接进入工作台；开启时HOST和APP_ORIGIN必须使用本机地址。
LOCAL_BROWSER_ACCESS=false
# 必填且非空，服务器端的管理登录密码，与 NS 凭证无关，不设最短字符数限制。
ADMIN_PASSWORD=
# 后续飞书等服务调用的独立密钥，至少 32 位；空值禁用服务调用。
SERVICE_API_KEY=
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# 本地开发默认 SQLite；后期 MySQL 8.0 使用下一行格式（密码需 URL 编码）。
DATABASE_URL=sqlite:///./data/ns-python.sqlite
# DATABASE_URL=mysql+pymysql://invoice_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/ns_invoice?charset=utf8mb4
# 独立六表业务库。设置USER后启用；密码填写原文，无需URL编码。
BUSINESS_MYSQL_HOST=127.0.0.1
BUSINESS_MYSQL_PORT=3306
BUSINESS_MYSQL_DATABASE=financial_invoice_business
BUSINESS_MYSQL_USER=
BUSINESS_MYSQL_PASSWORD=
# 也可只设置BUSINESS_DATABASE_URL，此时删除上述BUSINESS_MYSQL_*各项。
# BUSINESS_DATABASE_URL=mysql+pymysql://invoice_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/financial_invoice_business?charset=utf8mb4
# 后端直接提供 HTTPS 时同时设置；反向代理终止 HTTPS 时留空。
TLS_CERT_PATH=
TLS_KEY_PATH=
